    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --import tsx --test tests/core.test.ts tests/security.test.ts tests/content.test.ts",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:web": "expo export --platform web --output-dir dist",
